{
  "name": "taskpet",
  "version": "0.4.0",
  "description": "Local-first Windows desktop task assistant with a persistent pet companion.",
  "main": "src/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "compile:test": "tsc -p tsconfig.test.json",
    "start": "npm run compile && electron .",
    "dev": "npm run compile && electron .",
    "dev:bounds": "npm run compile && electron . --debug-pet-bounds",
    "smoke": "npm run compile && electron . --smoke-test",
    "build": "npm test && npm run compile && electron-builder --dir",
    "build:unpack": "npm run compile && electron-builder --dir",
    "build:win": "npm run compile && electron-builder --win --publish never",
    "build:mac": "npm run compile && electron-builder --mac --universal --publish never",
    "test": "npm run compile:test && node scripts/run-tests.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "taskpet",
    "desktop-pet",
    "task-assistant",
    "electron"
  ],
  "author": "TaskPet contributors",
  "license": "MIT",
  "homepage": "https://github.com/qwqsu/TaskPet",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwqsu/TaskPet.git"
  },
  "bugs": {
    "url": "https://github.com/qwqsu/TaskPet/issues"
  },
  "dependencies": {
    "better-sqlite3": "9.4.3",
    "koffi": "3.1.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.9",
    "@types/node": "18.19.31",
    "electron": "28.2.9",
    "electron-builder": "^24.13.3",
    "typescript": "5.4.5"
  }
}
